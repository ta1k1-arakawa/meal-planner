# Copy to .dev.vars for Wrangler. Never use a VITE_ prefix for secrets.
# Generate a long random password (at least 32 characters). Used on server only.
APP_PASSWORD=replace-with-a-long-random-password

# Optional paid image recognition. Disabled by default; do not set a real key for CI.
PHOTO_AI_ENABLED=false
GEMINI_PAID_TIER=false
# Server-only Gemini API key from a billing-enabled Paid Tier project.
# GEMINI_API_KEY=replace-locally-only-after-authorization
